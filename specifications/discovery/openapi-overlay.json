      "update": {
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/GenerateContentResponse"
              }
            }
          },
          "text/event-stream": {
            "schema": {
              "$ref": "#/components/schemas/GenerateContentResponse"
            }
          }
        }
      }
    },
